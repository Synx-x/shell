#!/usr/bin/env python3
"""Stop earlyoom killing a process that respawns straight after each kill.

A name killed CHURN_KILLS times within CHURN_WINDOW seconds goes on earlyoom's
--ignore list for IGNORE_FOR seconds, so earlyoom must pick the real memory hog.
Run by earlyoom-churn.path on each kill and by earlyoom-churn.timer for expiry.
"""
import os, subprocess, time

KILLS = "/run/earlyoom-churn/kills"
STATE = "/run/earlyoom-churn-ignore"
ENV = "/run/earlyoom-churn.env"
CHURN_KILLS, CHURN_WINDOW, IGNORE_FOR = 3, 60, 900

now = int(time.time())

def read_lines(path):
    try:
        with open(path) as f:
            return [l.split(maxsplit=1) for l in f if l.strip()]
    except FileNotFoundError:
        return []

kills = [(int(t), n.strip()) for t, n in read_lines(KILLS)]
ignore = {n.strip(): int(t) for t, n in read_lines(STATE) if int(t) > now}

recent = [n for t, n in kills if now - t <= CHURN_WINDOW]
for name in set(recent):
    if recent.count(name) >= CHURN_KILLS and name not in ignore:
        subprocess.run(["logger", "-t", "earlyoom-churn",
                        f"{name} killed {recent.count(name)}x in {CHURN_WINDOW}s, ignoring for {IGNORE_FOR}s"])
    if recent.count(name) >= CHURN_KILLS:
        ignore[name] = now + IGNORE_FOR

# Keep only the last 5 minutes of kills. Write only on change: this file is
# the path unit's trigger, so an unconditional write would loop.
kept = [(t, n) for t, n in kills if now - t <= 300]
if kept != kills:
    with open(KILLS, "w") as f:
        f.writelines(f"{t} {n}\n" for t, n in kept)
    # The sandboxed hook must still be able to append after a root rewrite.
    d = os.stat(os.path.dirname(KILLS))
    os.chown(KILLS, d.st_uid, d.st_gid)

with open(STATE, "w") as f:
    f.writelines(f"{t} {n}\n" for n, t in sorted(ignore.items()))

names = "|".join(sorted(ignore))
new_env = f"EARLYOOM_CHURN=--ignore ^({names})$\n" if names else "EARLYOOM_CHURN=\n"
try:
    old_env = open(ENV).read()
except FileNotFoundError:
    old_env = "EARLYOOM_CHURN=\n"
if new_env != old_env:
    with open(ENV, "w") as f:
        f.write(new_env)
    subprocess.run(["systemctl", "--no-block", "restart", "earlyoom.service"])
