# Let wheel members set the battery charge limit. This replaces the 0666 rule from PR #1908.
ACTION=="add|change", SUBSYSTEM=="power_supply", KERNEL=="BAT*", ATTR{charge_control_end_threshold}!="", RUN+="/usr/bin/chgrp wheel /sys%p/charge_control_end_threshold", RUN+="/usr/bin/chmod 0664 /sys%p/charge_control_end_threshold"
